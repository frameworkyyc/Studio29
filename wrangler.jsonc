{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio29",
  "main": "worker/index.ts",
  // Wrangler runs this before reading assets.directory, so `wrangler deploy` works from a clean
  // clone even if the Cloudflare "Build command" field is empty (dist/ is not committed).
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths return index.html so React Router handles client-side routes.
    "not_found_handling": "single-page-application",
    // Only /api/* hits the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "previews": {}
}
